# Copy to .env.local (gitignored) and fill in values.

# Base URL of the deployed CoralSwift backend (Swagger: {BASE_URL}/docs).
NEXT_PUBLIC_API_BASE_URL=https://backend.onrender.com

# Public deployed site URL for canonical links and OpenGraph / social share preview cards.
# In Vercel or Netlify, this is auto-detected, or you can set: NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://coralswift.com

# Anti-bot token sent as the x-bot-token header on public submissions.
# Value/issuance mechanism to be provided by the backend team.
NEXT_PUBLIC_BOT_TOKEN=
